#!/bin/sh
# Minimal init: only what cannot be known before boot. All static
# state (users, ssh host + client keys, authorized_keys) is baked
# into the image at build time.

mkdir -p /proc /sys/kernel/config /sys/kernel/debug /dev /mnt /tmp
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t configfs none /sys/kernel/config
mount -t debugfs none /sys/kernel/debug
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts -o newinstance,ptmxmode=0666
ln -sf /dev/pts/ptmx /dev/ptmx
mount -t 9p -o trans=virtio hostshare /mnt

if [ -f /mnt/.vm_extra_shares ]; then
	while IFS=' ' read -r _tag _guest_path; do
		[ -n "$_tag" ] || continue
		mkdir -p "$_guest_path"
		mount -t 9p -o trans=virtio "$_tag" "$_guest_path"
	done </mnt/.vm_extra_shares
fi

# Network from the kernel cmdline: koxi.net=dhcp,
# koxi.net=<addr>/<prefix>,<gateway>, or (absent) the qemu slirp
# defaults — the same image serves qemu and bare metal.
ip link set lo up
ip link set eth0 up
net="$(sed -n 's/.*koxi\.net=\([^ ]*\).*/\1/p' /proc/cmdline)"
case "$net" in
dhcp)
	udhcpc -i eth0 -n -q -s /etc/udhcpc.script
	;;
"")
	ip addr add 10.0.2.15/24 dev eth0
	ip route add default via 10.0.2.2
	;;
*)
	addr="${net%%,*}"
	gw="${net#*,}"
	ip addr add "$addr" dev eth0
	[ "$gw" != "$net" ] && ip route add default via "$gw"
	;;
esac

# Driver setup from the per-run overlay initrd (a second cpio the
# runner concatenates onto this base image, so the transport also
# works on bare metal). Failure powers off before ssh comes up —
# fail fast and visibly on the console.
if [ -s /koxi/driver_setup/spec ]; then
	driver_spec="$(cat /koxi/driver_setup/spec)"
	driver_prep=""
	[ -f /koxi/driver_setup/prep ] && driver_prep="$(cat /koxi/driver_setup/prep)"
	echo "Running driver setup..."
	if /koxi/scripts/vm_driver_setup "$driver_spec" "$driver_prep"; then
		echo ok >/koxi/driver_setup/status
	else
		echo "driver setup failed"
		poweroff -f
	fi
fi

# Public-key auth only (-s); keys and authorized_keys are baked.
dropbearmulti dropbear -p 22 -F -s &

# koxi.shell=1: interactive console session — banner, then power off
# on ENTER, returning the console (cable-free bare-metal smoke).
if grep -q 'koxi\.shell' /proc/cmdline; then
	echo
	echo "hello world — KOxI guest is up ($(uname -r))"
	echo "press ENTER to power off and relinquish the console"
	read -r _
	poweroff -f
fi

while :; do sleep 3600; done
