#!/bin/sh
# udhcpc hook: apply the DHCP lease (busybox exports interface, ip,
# subnet, router into the environment).
case "$1" in
bound | renew)
	ifconfig "$interface" "$ip" netmask "${subnet:-255.255.255.0}"
	if [ -n "${router:-}" ]; then
		ip route replace default via "${router%% *}"
	fi
	;;
deconfig)
	ifconfig "$interface" 0.0.0.0
	;;
esac
