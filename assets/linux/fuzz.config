# KOxI fuzz-flavor kconfig fragment: the instrumentation the fuzzing
# kernel needs and the perf kernel must not pay for. Merged onto the
# base linux/config with scripts/kconfig/merge_config.sh; after
# olddefconfig, every directive here is asserted against the final
# .config — a dropped symbol fails the build instead of silently
# defanging fuzzing.
CONFIG_KASAN=y
CONFIG_KCOV=y
CONFIG_KCOV_INSTRUMENT_ALL=y
CONFIG_KCOV_IRQ_AREA_SIZE=0x40000
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_COMPRESSED_NONE=y
CONFIG_FUNCTION_ERROR_INJECTION=y
CONFIG_FAULT_INJECTION=y
CONFIG_FAULT_INJECTION_DEBUG_FS=y
CONFIG_FAULT_INJECTION_CONFIGFS=y
CONFIG_FAILSLAB=y
CONFIG_FAIL_PAGE_ALLOC=y
CONFIG_FAIL_MAKE_REQUEST=y
CONFIG_FAIL_IO_TIMEOUT=y
CONFIG_FAIL_FUNCTION=y
